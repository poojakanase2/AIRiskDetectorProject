pipeline {
    agent any
    stages {
        stage('Backend Tests') {
            steps {
                dir('./backend') {
                    sh 'python -m pytest'
                }
            }
        }
        stage('Frontend Lint') {
            steps {
                dir('./frontend') {
                    sh 'ls -l'
                }
            }
        }
        stage('Build') {
            steps {
                sh 'echo "Build step placeholder"'
            }
        }
    }
    post {
        always {
            echo 'Pipeline finished.'
        }
        success {
            echo 'SUCCESS!'
        }
        failure {
            echo 'FAILURE!'
        }
    }
}
