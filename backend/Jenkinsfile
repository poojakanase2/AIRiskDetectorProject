pipeline {
    agent any
    environment {
        // Add any required environment variables here
    }
    stages {
        stage('Backend Lint') {
            steps {
                dir('backend') {
                    // Use python3 -m pip to ensure pip is available
                    sh 'python3 -m pip install --upgrade pip'
                    sh 'python3 -m pip install flake8'
                    sh 'python3 -m flake8 .'
                }
            }
        }
        stage('Backend Test') {
            steps {
                dir('backend') {
                    sh 'python3 -m pip install pytest'
                    sh 'python3 -m pytest'
                }
            }
        }
        stage('Frontend Lint') {
            steps {
                dir('frontend') {
                    // No npm build needed, so just check for HTML/CSS/JS lint if required
                    // Example: sh 'htmlhint *.html' (if htmlhint is installed)
                    echo 'Frontend lint step (no npm build required)'
                }
            }
        }
        stage('Frontend Smoke Test') {
            steps {
                dir('frontend') {
                    // Example: curl or simple test
                    echo 'Frontend smoke test step (no npm build required)'
                }
            }
        }
    }
}