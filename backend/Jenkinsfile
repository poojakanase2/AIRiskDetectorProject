pipeline {
    agent any

    environment {
        APP_NAME = "DemoApp"
        BUILD_ENV = "dev"
    }

    stages {

        stage('Checkout') {
            steps {
                echo "Cloning repository..."
                git 'https://github.com/sample/demo.git'
            }
        }

        stage('Build') {
            steps {
                echo "Building application"
                sh 'mvn clean package'
            }
        }

        stage('Test') {
            steps {
                echo "Running tests..."
                sh 'mvn test'
            }
        }

        stage('Deploy') {
            steps {
                echo "Deploying application..."
                sh "scp target/app.jar ubuntu@server:/apps/"
            }
        }
    }

    post {
        success {
            echo "Build Successful"
        }
        failure {
            echo "Build Failed"
        }
    }
}
