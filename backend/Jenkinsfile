pipeline {
    agent any

    environment {
        APP_NAME = "InventoryService"
        VERSION = "1.0"
        MVN_PATH = "/var/lib/jenkins/tools/hudson.tasks.Maven_MavenInstallation/maven/bin/mvn"
    }

    stages {
        stage('Checkout') {
            steps {
                echo "Cloning repository..."
                git url: 'https://github.com/poojakanase2/AIRiskDetectorProject.git',
                    branch: 'main'
            }
        }

        stage('Build') {
            steps {
                echo "Building Maven project..."
                sh "${env.MVN_PATH} clean install"
            }
        }

        stage('Code Scan') {
            steps {
                echo "Running SonarQube scan..."
                sh "${env.MVN_PATH} sonar:sonar"
            }
        }

        stage('Docker Build') {
            steps {
                echo "Building Docker image..."
                sh 'docker build -t inventory-app:v1 .'
            }
        }

        stage('Deploy') {
            steps {
                echo "Deploying application..."
                sh 'kubectl apply -f deployment.yaml'
            }
        }
    }

    post {
        success {
            echo "Pipeline executed successfully"
        }
        failure {
            echo "Pipeline failed"
        }
    }
}
