pipeline {
    agent any
    environment {
        PYTHONPATH = "${WORKSPACE}/backend"
    }
    stages {
        stage('Backend - Install & Test') {
            steps {
                dir('backend') {
                    sh '''
                        python3 -m venv venv
                        . venv/bin/activate
                        pip install --upgrade pip
                        pip install -r requirements.txt
                        pytest
                    '''
                }
            }
        }
        stage('Frontend - Lint') {
            steps {
                dir('frontend') {
                    sh '''
                        # Example: HTMLHint or custom lint, but vanilla HTML/CSS/JS so just check for existence
                        test -f index.html
                        test -f style.css || true
                        test -f script.js || true
                    '''
                }
            }
        }
    }
}
