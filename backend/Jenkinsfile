pipeline {
    agent any
    stages {
        stage('Backend Lint') {
            steps {
                dir('backend') {
                    // Ensure pip is installed before upgrading
                    sh '''
                        python3 -m ensurepip --upgrade || sudo apt-get install -y python3-pip
                        python3 -m pip install --upgrade pip
                    '''
                }
            }
        }
        stage('Backend Test') {
            steps {
                dir('backend') {
                    sh 'pytest'
                }
            }
        }
        stage('Frontend Lint') {
            steps {
                dir('frontend') {
                    sh 'echo "Linting frontend..."'
                }
            }
        }
        stage('Frontend Smoke Test') {
            steps {
                dir('frontend') {
                    sh 'echo "Running frontend smoke tests..."'
                }
            }
        }
    }
}