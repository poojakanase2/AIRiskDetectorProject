pipeline {
    agent any

    environment {
        IMAGE_NAME = "demo-app"
        TAG = "latest"
    }

    stages {
        stage('Checkout') {
            steps {
                echo "Fetching code from GitHub..."
            }
        }
        stage('Backend Lint') {
            steps {
                dir('backend') {
                    sh 'pip install flake8 && flake8 .'
                }
            }
        }
        stage('Backend Test') {
            steps {
                dir('backend') {
                    sh 'pip install -r requirements.txt && pytest'
                }
            }
        }
        stage('Frontend Lint') {
            steps {
                dir('frontend') {
                    sh 'find . -name "*.js" -exec echo "Linting {}" \;'
                }
            }
        }
        stage('Build Docker Image') {
            steps {
                sh 'docker build -t $IMAGE_NAME:$TAG .'
            }
        }
    }
}
