pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps {
                git url: 'https://github.com/poojakanase2/AIRiskDetectorProject.git', branch: 'main'
            }
        }
        stage('Backend Build') {
            steps {
                dir('backend') {
                    sh 'pip install -r requirements.txt'
                }
            }
        }
        stage('Backend Test') {
            steps {
                dir('backend') {
                    sh 'pytest'
                }
            }
        }
        stage('Frontend Test') {
            steps {
                dir('frontend') {
                    sh 'echo "No frontend build step required"'
                }
            }
        }
        stage('Deploy') {
            steps {
                sh 'echo "Deploying application..."'
            }
        }
    }
}
