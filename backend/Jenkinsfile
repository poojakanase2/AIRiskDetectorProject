pipeline {
    agent any
    environment {
        PYTHONPATH = "${WORKSPACE}/backend"
    }
    stages {
        stage('Backend Lint') {
            steps {
                dir('backend') {
                    // Ensure Python and pip are available
                    sh '''which python || which python3 || (echo "Python not found" && exit 1)'''
                    sh '''which pip || which pip3 || (echo "pip not found" && exit 1)'''
                    sh '''pip install --upgrade pip || pip3 install --upgrade pip'''
                    sh '''pip install flake8 || pip3 install flake8'''
                    sh '''flake8 .'''
                }
            }
        }
        stage('Backend Test') {
            steps {
                dir('backend') {
                    sh '''pip install pytest || pip3 install pytest'''
                    sh '''pytest'''
                }
            }
        }
        stage('Frontend Lint') {
            steps {
                dir('frontend') {
                    sh '''echo "Linting frontend (HTML/CSS/JS)"'''
                    sh '''find . -name "*.html" -exec echo "Linting {}" \;'''
                }
            }
        }
        stage('Frontend Smoke Test') {
            steps {
                dir('frontend') {
                    sh '''echo "Running frontend smoke tests"'''
                    sh '''test -f index.html'''
                }
            }
        }
    }
}
