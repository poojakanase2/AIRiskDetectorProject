pipeline {
    agent any
    stages {
        stage('Backend Lint') {
            steps {
                dir('backend') {
                    sh 'pip install flake8'
                    sh 'flake8 .'
                }
            }
        }
        stage('Backend Test') {
            steps {
                dir('backend') {
                    sh 'pip install -r requirements.txt'
                    sh 'pytest'
                }
            }
        }
        stage('Backend Build') {
            steps {
                dir('backend') {
                    sh 'pip install -r requirements.txt'
                    sh 'python setup.py sdist bdist_wheel || true'
                }
            }
        }
        stage('Frontend Lint') {
            steps {
                dir('frontend') {
                    sh 'echo "No linting required for vanilla JS/HTML/CSS"'
                }
            }
        }
        stage('Frontend Test') {
            steps {
                dir('frontend') {
                    sh 'echo "No tests defined for vanilla JS/HTML/CSS"'
                }
            }
        }
    }
    post {
        always {
            cleanWs()
        }
    }
}
