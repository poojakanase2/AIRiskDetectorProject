pipeline {
    agent any
    stages {
        stage('Backend Lint') {
            steps {
                dir('backend') {
                    // Ensure pip is installed before using it
                    sh '''
                        python3 -m ensurepip --upgrade || sudo apt-get install -y python3-pip
                        python3 -m pip install --upgrade pip
                    '''
                    sh 'python3 -m pip install flake8'
                    sh 'flake8 .'
                }
            }
        }
        stage('Backend Test') {
            steps {
                dir('backend') {
                    sh 'python3 -m pip install -r requirements.txt'
                    sh 'pytest'
                }
            }
        }
        stage('Frontend Lint') {
            steps {
                dir('frontend') {
                    sh 'echo "Linting frontend (HTML/CSS/JS)"'
                    sh 'find . -name "*.html" -exec tidy -q -e {} \; || true'
                }
            }
        }
        stage('Frontend Smoke Test') {
            steps {
                dir('frontend') {
                    sh 'echo "Running frontend smoke tests"'
                    sh 'grep -q "<html" index.html'
                }
            }
        }
    }
}